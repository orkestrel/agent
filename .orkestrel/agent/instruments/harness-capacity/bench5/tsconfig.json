{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2023",
		"lib": ["es2023"],
		"types": ["node"],
		"typeRoots": ["../node_modules/@types", "../../../../../node_modules/@types"],
		"skipLibCheck": true
	},
	"include": ["./**/*.ts"]
}
