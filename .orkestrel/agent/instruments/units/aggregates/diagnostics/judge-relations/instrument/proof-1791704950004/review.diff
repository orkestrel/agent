+	ok(judge instanceof AgentJudge)
+	equal(judge.model, packet.identity)
+	deepStrictEqual(tuple[3], { num_ctx: 4096, num_predict: 1, temperature: 1 })
+	equal(tuple[2], 1.1244734010661372)
+	equal(tuple[4], 'mica-native-2026-10-07-v1')
