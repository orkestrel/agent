+export const ATTEMPTS_HASH = '6258734af06361ee0337236311c04eb970f79e190ea103082dd8d5af6db66a8d'
+export const EVIDENCE_HASH = '24fddf4bfc7d870a49395ad72b62d5bf8429ebb27e56d18e8f3d666fc1ba81b2'
