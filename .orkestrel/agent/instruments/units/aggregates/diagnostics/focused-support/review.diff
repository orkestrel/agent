+import { mkdirSync, readdirSync, readFileSync } from 'node:fs'
+import { relative, resolve, sep } from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { BUILD, ROOT } from '../aggregate-judge-counterfactual/constants.ts'
+import { readBinding, writeArtifact } from '../aggregate-judge-counterfactual/helpers.ts'
+import { PREDECESSOR, SPECIFICATION, UNIT } from './constants.ts'
+import { computeOperator, validateDestination } from './helpers.ts'
+
+/** Retains reproducible local commands and their bare outputs without accepting the unit. */
+export class Verifier {
+	/** Executes scoped offline gates into a vacant owned evidence directory.
+	 * @param output - A vacant descendant for immutable gate evidence
+	 * @returns Nothing after retaining commands, output, hashes, and inventory
+	 * @example new Verifier().execute('tmp/units/aggregate-focused-screen/verifier-evidence')
+	 */
+	execute(output: string): void {
+		validateDestination(output)
+		mkdirSync(resolve(output))
+		const commands = [
+			['node_modules/typescript/bin/tsc', '-p', 'tmp/units/aggregate-focused-screen/tsconfig.json'],
+			...readdirSync(UNIT).filter(name => name.endsWith('.ts')).map(name => ['--check', relative(ROOT, resolve(UNIT, name)).split(sep).join('/')]),
+			['--test', 'tmp/units/aggregate-focused-screen/proof.test.ts'],
+			['--test', 'tmp/units/aggregate-focused-screen/negative.test.ts'],
+			['tmp/units/aggregate-focused-screen/offline.config.ts'],
+			['tmp/units/aggregate-focused-screen/prepare.ts', '--output', relative(ROOT, resolve(output, 'census')).split(sep).join('/')],
+		]
+		const results = commands.map(args => {
+			const result = spawnSync(process.execPath, args, { cwd: ROOT, encoding: 'utf8' })
+			const expected = args[0] === '--test' && args[1] === 'tmp/units/aggregate-focused-screen/negative.test.ts' ? 1 : 0
+			console.log(JSON.stringify({ args, expected, exit: result.status, stdout: result.stdout, stderr: result.stderr }))
+			if (result.error !== undefined || result.status !== expected) throw new Error(`Scoped command failed: ${JSON.stringify(args)}`)
+			return { args, expected, exit: result.status, stdout: result.stdout, stderr: result.stderr }
+		})
+		const status = spawnSync('git', ['status', '--porcelain'], { cwd: ROOT, encoding: 'utf8' })
+		const diff = spawnSync('git', ['diff', '--stat'], { cwd: ROOT, encoding: 'utf8' })
+		if (status.status !== 0 || diff.status !== 0) throw new Error('Git status/diff observation failed')
+		writeArtifact(resolve(output, 'verification.json'), { results, status: status.stdout, diff: diff.stdout, operator: computeOperator(), predecessor: readBinding(PREDECESSOR), build: readBinding(BUILD), specification: readBinding(SPECIFICATION), inventory: readdirSync(UNIT).filter(name => name.endsWith('.ts') || name === 'tsconfig.json').map(name => ({ ...readBinding(resolve(UNIT, name)), text: readFileSync(resolve(UNIT, name), 'utf8') })), interpretation: 'Writer self-reported offline gates; independent acceptance remains required. No live request has run.' })
+	}
+}
