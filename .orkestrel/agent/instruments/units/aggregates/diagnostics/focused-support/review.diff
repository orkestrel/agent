+import type { AggregateSource } from '../../../.orkestrel/agent/instruments/harness/.build/bench5/types.js'
+import type { ExecutionOptions, Packet } from '../aggregate-judge-counterfactual/types.ts'
+import type { Census, Comparison, RankingReading, RankingResult, ScreenPacket, Span } from './types.ts'
+import { existsSync, lstatSync, realpathSync } from 'node:fs'
+import { isAbsolute, relative, resolve, sep } from 'node:path'
+import { renderSource } from '../../../.orkestrel/agent/instruments/harness/.build/bench5/aggregates/helpers.js'
+import { splitSentences } from '../../../.orkestrel/agent/instruments/harness/.build/vendor/agent-0.0.30-trimmed/index.js'
+import { BUILD, BUILD_HASH, ROOT } from '../aggregate-judge-counterfactual/constants.ts'
+import { computeHash, readArray, readBinding, readJSON, readNumber, readObject, readPacket, readString, replaceTarget } from '../aggregate-judge-counterfactual/helpers.ts'
+import { FOCUS_MARKER, LABELS, LABELS_HASH, OPERATOR_FILES, ORIGINAL, ORIGINAL_HASH, PACKET, PREDECESSOR, PREDECESSOR_HASH, SEQUENCE, SPECIFICATION, SPECIFICATION_HASH, UNIT } from './constants.ts'
+
+/** Reads only the fields the emitted source renderer consumes.
+ * @param value - A complete original source object
+ * @returns The renderer's source projection
+ * @example readSource({ id: 'source', sentence: 0, role: 'user', text: 'Complete.', day: '2026-10-10' })
+ */
+export function readSource(value: unknown): AggregateSource {
+	const source = readObject(value)
+	const role = source.role
+	if (role !== 'system' && role !== 'user' && role !== 'assistant' && role !== 'tool') throw new Error('Malformed source role')
+	return { id: readString(source.id), sentence: readNumber(source.sentence), role, text: readString(source.text), day: readString(source.day) }
+}
+
+/** Partitions complete candidate lines through the installed sentence primitive.
+ * @param candidate - The exact unchanged candidate
+ * @returns Disjoint UTF-16 slices covering every nonwhitespace character
+ * @example partitionCandidate('First. Second.').map(span => span.text)
+ */
+export function partitionCandidate(candidate: string): readonly Span[] {
+	const spans: Span[] = []
+	let offset = 0
+	for (const line of candidate.split(/\r\n|\n/)) {
+		let cursor = 0
+		if (line.trim() !== '') for (const text of splitSentences(line)) {
+			const start = line.indexOf(text, cursor)
+			if (text.trim() === '' || start < cursor || start < 0 || /\S/u.test(line.slice(cursor, start))) throw new Error('Malformed sentence coverage')
+			const end = start + text.length
+			spans.push({ start: offset + start, end: offset + end, text })
+			cursor = end
+		}
+		if (/\S/u.test(line.slice(cursor))) throw new Error('Uncovered line suffix')
+		offset += line.length
+		if (candidate.slice(offset, offset + 2) === '\r\n') offset += 2
+		else if (candidate[offset] === '\n') offset += 1
+	}
+	validateCoverage(candidate, spans)
+	return spans
+}
+
+/** Refuses gaps, overlaps, changed offsets, changed text, and empty coverage.
+ * @param candidate - The unchanged complete candidate
+ * @param spans - The prospective exact partition
+ * @returns Nothing when every nonwhitespace character is covered exactly once
+ * @example validateCoverage('Complete.', [{ start: 0, end: 9, text: 'Complete.' }])
+ */
+export function validateCoverage(candidate: string, spans: readonly Span[]): void {
+	if (spans.length === 0) throw new Error('Empty candidate coverage')
+	let cursor = 0
+	for (const span of spans) {
+		if (!Number.isSafeInteger(span.start) || !Number.isSafeInteger(span.end) || span.start < cursor || span.end <= span.start || span.end > candidate.length || span.text.trim() === '' || candidate.slice(span.start, span.end) !== span.text) throw new Error('Span offset/text custody mismatch')
+		if (/\S/u.test(candidate.slice(cursor, span.start))) throw new Error('Dropped nonwhitespace span coverage')
+		cursor = span.end
+	}
+	if (/\S/u.test(candidate.slice(cursor))) throw new Error('Dropped nonwhitespace suffix coverage')
+}
+
+/** Selects the unique frozen marker within the complete candidate partition.
+ * @param candidate - The unchanged complete candidate
+ * @param spans - Its checked complete coverage
+ * @returns The exact focus slice without rewriting
+ * @example selectFocus('Escalation ESC-2219 remains open because Sigrid reports damage.', partitionCandidate('Escalation ESC-2219 remains open because Sigrid reports damage.'))
+ */
+export function selectFocus(candidate: string, spans: readonly Span[]): Span {
+	validateCoverage(candidate, spans)
+	const start = candidate.indexOf(FOCUS_MARKER)
+	if (start < 0 || candidate.indexOf(FOCUS_MARKER, start + 1) !== -1) throw new Error('Frozen focus marker is absent or repeated')
+	const matches = spans.filter(span => span.start <= start && span.end >= start + FOCUS_MARKER.length)
+	const focus = matches[0]
+	if (matches.length !== 1 || focus === undefined) throw new Error('Unique focus span absent')
+	return { start: focus.start, end: focus.end, text: focus.text }
+}
+
+/** Selects a declared exact statement only when it equals a unique complete partition span.
+ * @param candidate - The complete corrected candidate
+ * @param spans - Its exhaustive checked coverage
+ * @param text - The specification's exact declared focus
+ * @returns The unique exact statement slice
+ * @example selectStatement('Complete.', partitionCandidate('Complete.'), 'Complete.')
+ */
+export function selectStatement(candidate: string, spans: readonly Span[], text: string): Span {
+	validateCoverage(candidate, spans)
+	const start = candidate.indexOf(text)
+	if (text.trim() === '' || start < 0 || candidate.indexOf(text, start + 1) !== -1) throw new Error('Declared focus is absent or repeated')
+	const matches = spans.filter(span => span.start === start && span.end === start + text.length && span.text === text)
+	const focus = matches[0]
+	if (matches.length !== 1 || focus === undefined) throw new Error('Declared focus is not one complete partition span')
+	return { start: focus.start, end: focus.end, text: focus.text }
+}
+
+/** Derives only the specified repair-line replacement from the predecessor baseline.
+ * @param predecessor - The unchanged accepted predecessor packet
+ * @param text - The corrected declared repair line
+ * @returns The complete candidate with its other lines unchanged
+ * @example deriveCandidate(readPacket(readJSON(PREDECESSOR)), 'CORRECTED_LINE')
+ */
+export function deriveCandidate(predecessor: Packet, text: string): string {
+	const baseline = predecessor.variants.filter(variant => variant.name === 'both-removed')
+	const variant = baseline[0]
+	if (baseline.length !== 1 || variant === undefined || /\r|\n/u.test(text)) throw new Error('Corrected candidate requires one baseline and one replacement line')
+	const focus = selectFocus(variant.candidate, partitionCandidate(variant.candidate))
+	if (!variant.candidate.split(/\r\n|\n/).includes(focus.text)) throw new Error('Baseline repair focus is not a complete line')
+	return replaceTarget(variant.candidate, focus.text, text)
+}
+
+/** Renders complete evidence, candidate context, and exact focus in frozen order.
+ * @param sources - The complete original ordered sources
+ * @param candidate - The exact unchanged complete candidate
+ * @param focus - A checked exact slice of that candidate
+ * @returns The state with one-space JSON indentation
+ * @example renderState([], 'Complete.', { start: 0, end: 9, text: 'Complete.' })
+ */
+export function renderState(sources: readonly unknown[], candidate: string, focus: Span): string {
+	if (!Number.isSafeInteger(focus.start) || !Number.isSafeInteger(focus.end) || focus.start < 0 || focus.end <= focus.start || focus.end > candidate.length || focus.text.trim() === '' || candidate.slice(focus.start, focus.end) !== focus.text) throw new Error('Focus slice custody mismatch')
+	return JSON.stringify({ evidence: sources.map(source => renderSource(readSource(source))), candidate, focus: { start: focus.start, end: focus.end, text: focus.text } }, null, 1)
+}
+
+/** Checks rendering custody through a separate JSON decode and source interpolation.
+ * @param state - The serialized state
+ * @param sources - The expected complete ordered sources
+ * @param candidate - The unchanged candidate
+ * @param focus - The exact expected focus
+ * @returns Nothing when every field round-trips unchanged
+ * @example validateState(renderState([], 'Complete.', { start: 0, end: 9, text: 'Complete.' }), [], 'Complete.', { start: 0, end: 9, text: 'Complete.' })
+ */
+export function validateState(state: string, sources: readonly unknown[], candidate: string, focus: Span): void {
+	const decoded = readObject(JSON.parse(state))
+	if (JSON.stringify(Object.keys(decoded)) !== JSON.stringify(['evidence', 'candidate', 'focus']) || decoded.candidate !== candidate) throw new Error('Candidate/property custody mismatch')
+	const decodedfocus = readObject(decoded.focus)
+	if (JSON.stringify(Object.keys(decodedfocus)) !== JSON.stringify(['start', 'end', 'text']) || JSON.stringify(decodedfocus) !== JSON.stringify(focus) || candidate.slice(focus.start, focus.end) !== focus.text) throw new Error('Focus offset/text custody mismatch')
+	const evidence = readArray(decoded.evidence).map(readString)
+	if (evidence.length !== sources.length) throw new Error('Source membership custody mismatch')
+	for (const [index, value] of sources.entries()) {
+		const source = readObject(value)
+		if (evidence[index] !== `(${readString(source.day)}) ${readString(source.role)}: ${readString(source.text)}`) throw new Error('Ordered source custody mismatch')
+	}
+}
+
+/** Computes the digest of the exact executable instrument bytes.
+ * @returns The source-population SHA-256
+ * @example computeOperator()
+ */
+export function computeOperator(): string {
+	return computeHash(JSON.stringify(OPERATOR_FILES.map(name => [name, readBinding(resolve(UNIT, name)).hash])))
+}
+
+/** Reads exact span fields without coercion.
+ * @param value - A decoded candidate span
+ * @returns Its numeric offsets and unchanged text
+ * @example readSpan({ start: 0, end: 9, text: 'Complete.' })
+ */
+export function readSpan(value: unknown): Span {
+	const span = readObject(value)
+	return { start: readNumber(span.start), end: readNumber(span.end), text: readString(span.text) }
+}
+
+/** Reads a complete candidate census without narrowing its source data.
+ * @param value - The decoded census member
+ * @returns Its exact candidate, spans, focus, and rendered state
+ * @example readCensus({ name: 'statement', candidate: 'Complete.', spans: [{ start: 0, end: 9, text: 'Complete.' }], focus: { start: 0, end: 9, text: 'Complete.' }, state: 'STATE' })
+ */
+export function readCensus(value: unknown): Census {
+	const row = readObject(value)
+	return { name: readString(row.name), candidate: readString(row.candidate), spans: readArray(row.spans).map(readSpan), focus: readSpan(row.focus), state: readString(row.state) }
+}
+
+/** Reads corrected screen fields and verifies its fixed document bindings.
+ * @param value - The decoded contextual packet
+ * @returns The complete corrected screen shape
+ * @example readScreen(readJSON(PACKET))
+ */
+export function readScreen(value: unknown): ScreenPacket {
+	const row = readObject(value)
+	return {
+		id: readString(row.id), identity: readString(row.identity), digest: readString(row.digest), question: row.question,
+		separator: readString(row.separator), sources: readArray(row.sources), suffix: readString(row.suffix), sequence: readArray(row.sequence).map(readString),
+		bindings: readArray(row.bindings).map(entry => { const binding = readObject(entry); return readBinding(resolve(ROOT, readString(binding.path)), readString(binding.hash)) }),
+		rendering: readArray(row.rendering).map(entry => { const rendering = readObject(entry); return { name: readString(rendering.name), body: readString(rendering.body) } }),
+		variants: readArray(row.variants).map(readCensus), census: readArray(row.census).map(readCensus), operator: readString(row.operator),
+		specification: readBinding(SPECIFICATION, readString(readObject(row.specification).hash)), original: readBinding(ORIGINAL, readString(readObject(row.original).hash)), predecessor: readBinding(PREDECESSOR, readString(readObject(row.predecessor).hash)), labels: readBinding(LABELS, readString(readObject(row.labels).hash)),
+	}
+}
+
+/** Checks complete predecessor evidence, exhaustive census, and corrected single-line custody.
+ * @param packet - The prepared contextual screen
+ * @param predecessor - The unchanged accepted predecessor
+ * @returns Nothing when complete candidates and focus selections match the specification
+ * @example validatePopulation(readScreen(readJSON(PACKET)), readPacket(readJSON(PREDECESSOR)))
+ */
+export function validatePopulation(packet: ScreenPacket, predecessor: Packet): void {
+	if (packet.id !== predecessor.id || packet.identity !== predecessor.identity || packet.digest !== predecessor.digest || packet.separator !== predecessor.separator || packet.suffix !== predecessor.suffix || JSON.stringify(packet.sources) !== JSON.stringify(predecessor.sources) || JSON.stringify(packet.sequence) !== JSON.stringify(SEQUENCE)) throw new Error('Predecessor population custody mismatch')
+	if (packet.census.length !== predecessor.variants.length) throw new Error('Census membership custody mismatch')
+	for (const [index, census] of packet.census.entries()) {
+		const original = predecessor.variants[index]
+		if (original === undefined || census.name !== original.name || census.candidate !== original.candidate) throw new Error('Predecessor candidate census mismatch')
+		validateCoverage(original.candidate, census.spans)
+		if (JSON.stringify(census.spans) !== JSON.stringify(partitionCandidate(original.candidate)) || JSON.stringify(census.focus) !== JSON.stringify(selectFocus(original.candidate, census.spans))) throw new Error('Frozen predecessor partition/focus mismatch')
+		validateState(census.state, predecessor.sources, original.candidate, census.focus)
+		if (census.state !== renderState(predecessor.sources, original.candidate, census.focus)) throw new Error('Frozen census serialization mismatch')
+	}
+	const specification = readObject(readJSON(SPECIFICATION))
+	const declared = readArray(specification.variants).map(readObject)
+	if (packet.variants.length !== declared.length) throw new Error('Corrected variant membership mismatch')
+	for (const [index, variant] of packet.variants.entries()) {
+		const expected = declared[index]
+		if (expected === undefined || variant.name !== expected.name || variant.candidate !== expected.candidate || variant.candidate !== deriveCandidate(predecessor, readString(expected.focus))) throw new Error('Corrected candidate single-line custody mismatch')
+		validateCoverage(variant.candidate, variant.spans)
+		if (JSON.stringify(variant.spans) !== JSON.stringify(partitionCandidate(variant.candidate)) || JSON.stringify(variant.focus) !== JSON.stringify(selectStatement(variant.candidate, variant.spans, readString(expected.focus)))) throw new Error('Corrected partition/focus custody mismatch')
+		validateState(variant.state, predecessor.sources, variant.candidate, variant.focus)
+		if (variant.state !== renderState(predecessor.sources, variant.candidate, variant.focus)) throw new Error('Frozen corrected state serialization mismatch')
+	}
+	if (JSON.stringify(packet.rendering.map(entry => entry.name)) !== JSON.stringify(['statement-a', 'statement-b'])) throw new Error('Only the corrected pair can have frozen live bodies')
+}
+
+/** Validates exact execution hashes, accepted labels, and every runtime binding before fetch.
+ * @param options - Explicit execution custody arguments
+ * @returns The checked frozen screen
+ * @example validateExecution({ packet: 'HASH', build: 'HASH', operator: 'HASH', output: 'DIRECTORY' })
+ */
+export function validateExecution(options: ExecutionOptions): ScreenPacket {
+	if (!/^[a-f0-9]{64}$/.test(options.packet) || !/^[a-f0-9]{64}$/.test(options.operator) || options.build !== BUILD_HASH) throw new Error('Expected exact packet/build/operator hash arguments')
+	readBinding(PACKET, options.packet)
+	readBinding(BUILD, options.build)
+	if (computeOperator() !== options.operator) throw new Error('Operator hash mismatch')
+	validateDestination(options.output)
+	const packet = readScreen(readJSON(PACKET))
+	if (packet.operator !== options.operator || packet.specification.hash !== SPECIFICATION_HASH || packet.original.hash !== ORIGINAL_HASH || packet.predecessor.hash !== PREDECESSOR_HASH || packet.labels.hash !== LABELS_HASH) throw new Error('Frozen packet custody mismatch')
+	for (const binding of packet.bindings) readBinding(resolve(ROOT, binding.path), binding.hash)
+	if (JSON.stringify(packet.question) !== JSON.stringify(readObject(readJSON(SPECIFICATION)).question)) throw new Error('Frozen question mismatch')
+	validatePopulation(packet, readPacket(readJSON(PREDECESSOR)))
+	return packet
+}
+
+/** Refuses occupied output and paths outside the owned directory.
+ * @param path - The proposed create-only descendant
+ * @returns Nothing when output custody holds
+ * @example validateDestination('OWNED_DIRECTORY')
+ */
+export function validateDestination(path: string): void {
+	const output = resolve(path)
+	const descendant = relative(realpathSync(UNIT), output)
+	if (descendant === '' || descendant === '..' || descendant.startsWith(`..${sep}`) || isAbsolute(descendant)) throw new Error('Output must be a descendant of the owned directory')
+	let cursor = realpathSync(UNIT)
+	for (const segment of descendant.split(sep)) {
+		cursor = resolve(cursor, segment)
+		if (existsSync(cursor) && lstatSync(cursor).isSymbolicLink()) throw new Error('Output crosses a symbolic link')
+	}
+	if (existsSync(output)) throw new Error('Output directory is occupied')
+}
+
+/** Compares the accepted supported focus independently in each corrected pass.
+ * @param readings - Sequential normalized scores without averaging
+ * @returns Incomplete for a prefix, refused for equality or reversal, or passed
+ * @example computeRanking([]).status // 'incomplete'
+ */
+export function computeRanking(readings: readonly RankingReading[]): RankingResult {
+	if (readings.length > SEQUENCE.length) throw new Error('Ranking sequence overrun')
+	for (const [index, reading] of readings.entries()) if (reading.ordinal !== index + 1 || reading.name !== SEQUENCE[index] || !Number.isFinite(reading.score) || reading.score < 0 || reading.score > 1) throw new Error('Ranking sequence or finite probability mismatch')
+	if (readings.length !== SEQUENCE.length) return { status: 'incomplete', comparisons: [] }
+	const comparisons: Comparison[] = []
+	for (const offset of [0, 2]) {
+		const pass = offset === 0 ? 'forward' : 'reverse'
+		const batch = readings.slice(offset, offset + 2)
+		const supported = batch.find(reading => reading.name === 'statement-b')
+		const unsupported = batch.find(reading => reading.name === 'statement-a')
+		if (supported === undefined || unsupported === undefined) throw new Error('Focused ranking member absent')
+		comparisons.push({ pass, supported: supported.score, unsupported: unsupported.score, exceeds: supported.score > unsupported.score })
+	}
+	return { status: comparisons.every(comparison => comparison.exceeds) ? 'passed' : 'refused', comparisons }
+}
+
