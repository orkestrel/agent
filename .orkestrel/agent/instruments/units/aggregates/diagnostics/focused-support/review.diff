+export const UNIT = dirname(fileURLToPath(import.meta.url))
+/** Names the frozen specification. */
+export const SPECIFICATION = resolve(UNIT, '../../../.orkestrel/agent/instruments/units/aggregates/admission-focus-r2.json')
+/** Binds the root-selected specification bytes. */
+export const SPECIFICATION_HASH = 'bd907fbb6b214f3fba41115e8ef31a83a58a5174d26ae153efc66d5c893bae71'
+/** Names the superseded specification retained as custody evidence. */
+export const ORIGINAL = resolve(UNIT, '../../../.orkestrel/agent/instruments/units/aggregates/admission-focus.json')
+/** Binds the superseded specification bytes. */
+export const ORIGINAL_HASH = '77e8419febb89e3e3bc2af58fed8d4987e1dde472f74da2fa56afe039793c88c'
+/** Names the accepted predecessor packet. */
+export const PREDECESSOR = resolve(UNIT, '../aggregate-admission-screen-r2/packet-final.json')
+/** Binds the accepted predecessor packet bytes. */
+export const PREDECESSOR_HASH = '5bcb670e5304dce5fd688500f1a8e62e1edbc01f14124513441ead0a51bb6470'
+/** Names the root-owned accepted independent label record. */
+export const LABELS = resolve(UNIT, '../../../.orkestrel/agent/instruments/units/aggregates/reports/resumption-focus-labels.md')
+/** Binds root's accepted corrected focus labels. */
+export const LABELS_HASH = '32df326cece3fd686ae6bda040af74aee30254687684d93f153c71e9b9e53cb2'
+/** Names the create-only prepared packet. */
+export const PACKET = resolve(UNIT, 'packet-final.json')
+/** Names the executable source population bound by the operator digest. */
+export const OPERATOR_FILES = Object.freeze(['types.ts', 'constants.ts', 'helpers.ts', 'Operator.ts', 'main.ts', 'prepare.ts', 'offline.config.ts'])
+/** Names emitted modules added to the predecessor runtime bindings. */
+export const EMITTED_FILES = Object.freeze(['bench5/aggregates/helpers.js', 'bench5/aggregates/helpers.d.ts', 'bench5/aggregates/constants.js', 'bench5/aggregates/constants.d.ts', 'bench5/types.js', 'bench5/types.d.ts', 'vendor/agent-0.0.30-trimmed/index.js', 'vendor/agent-0.0.30-trimmed/index.d.ts'])
+/** Names accepted instrument files imported at runtime. */
+export const REUSED_FILES = Object.freeze(['types.ts', 'constants.ts', 'helpers.ts', 'Recorder.ts', 'Completion.ts', 'NetworkWitness.ts'])
+/** Names the corrected frozen forward and reverse request order. */
+export const SEQUENCE = Object.freeze(['statement-a', 'statement-b', 'statement-b', 'statement-a'])
+/** Names the frozen focus selector without changing candidate prose. */
+export const FOCUS_MARKER = 'Escalation ESC-2219 remains open because Sigrid reports'
