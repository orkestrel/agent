+import { EMITTED_FILES, FOCUS_MARKER, LABELS_HASH, ORIGINAL_HASH, PACKET, PREDECESSOR, PREDECESSOR_HASH, REUSED_FILES, SEQUENCE, SPECIFICATION, SPECIFICATION_HASH, UNIT } from './constants.ts'
+import { computeOperator, computeRanking, deriveCandidate, partitionCandidate, readCensus, readScreen, readSource, readSpan, renderState, selectFocus, selectStatement, validateCoverage, validateDestination, validateExecution, validatePopulation, validateState } from './helpers.ts'
+import { Operator } from './Operator.ts'
+
+test('date prefixes, repeated text, line endings, Unicode offsets, and trailing assertions remain covered', () => {
+	const candidate = ' \t(2026-10-10) user: Echo. Echo.\r\n\n(2026-10-11) assistant: "Quoted." She agreed.\n Ω😀 stays together, and repair is mandatory. \t'
+	const spans = partitionCandidate(candidate)
+	deepStrictEqual(spans.map(span => span.text), ['(2026-10-10) user: Echo.', 'Echo.', '(2026-10-11) assistant: "Quoted." She agreed.', 'Ω😀 stays together, and repair is mandatory.'])
+	deepStrictEqual(spans.map(span => span.start), [2, 27, 35, 82])
+	for (const span of spans) equal(candidate.substring(span.start, span.end), span.text)
+	validateCoverage(candidate, spans)
+	throws(() => partitionCandidate(' \t\r\n'), /Empty/)
+	throws(() => validateCoverage(candidate, spans.slice(1)), /Dropped/)
+	throws(() => validateCoverage(candidate, spans.slice(0, -1)), /suffix/)
+	throws(() => validateCoverage(candidate, spans.map((span, index) => index === 1 ? { ...span, start: span.start - 1 } : span)), /custody/)
+	throws(() => validateCoverage(candidate, spans.map((span, index) => index === 1 ? { ...span, text: `${span.text}!` } : span)), /custody/)
+	throws(() => validateCoverage(candidate, [...spans, ...spans]), /custody/)
+})
+
+test('installed punctuation and abbreviation semantics preserve every exact character without extra splitting', () => {
+	const candidate = 'Dr. Hester paid 12.50. "Ask her." It depends on her consent, and the repair must finish.\nNext? Yes! “Quoted” remains.'
+	const spans = partitionCandidate(candidate)
+	deepStrictEqual(spans.map(span => span.text), ['Dr.', 'Hester paid 12.50.', '"Ask her." It depends on her consent, and the repair must finish.', 'Next?', 'Yes!', '“Quoted” remains.'])
+	validateCoverage(candidate, spans)
+	ok(spans.some(span => span.text.includes('and the repair must finish.')))
+	deepStrictEqual(readSpan({ start: 0, end: 3, text: 'Dr.' }), { start: 0, end: 3, text: 'Dr.' })
+	throws(() => readSpan({ start: '0', end: 3, text: 'Dr.' }), /finite/)
+})
+
+test('every original variant supplies unique repair focus and exact source/candidate/focus round-trip', () => {
+	const original = readPacket(readJSON(PREDECESSOR))
+	for (const variant of original.variants) {
+		const spans = partitionCandidate(variant.candidate)
+		const focus = selectFocus(variant.candidate, spans)
+		equal(spans.length, 3)
+		ok(focus.text.startsWith('(2026-10-10) user: '))
+		ok(focus.text.includes(FOCUS_MARKER))
+		ok(focus.text.includes("requiring an electrician's repair") === (variant.name === 'original' || variant.name === 'cause-removed'))
+		const state = renderState(original.sources, variant.candidate, focus)
+		validateState(state, original.sources, variant.candidate, focus)
+		const decoded = readObject(JSON.parse(state))
+		deepStrictEqual(Object.keys(decoded), ['evidence', 'candidate', 'focus'])
+		equal(decoded.candidate, variant.candidate)
+		deepStrictEqual(decoded.focus, focus)
+		deepStrictEqual(decoded.evidence, original.suffix.split(/\r\n|\n/))
+		equal(state, JSON.stringify(decoded, null, 1))
