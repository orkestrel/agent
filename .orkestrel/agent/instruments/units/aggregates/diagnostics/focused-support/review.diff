+/** Carries an exact UTF-16 half-open candidate slice. */
+export interface Span {
+	readonly start: number
+	readonly end: number
+	readonly text: string
+}
+
+/** Carries complete coverage independently of the selected live pair. */
+export interface Census {
+	readonly name: string
+	readonly candidate: string
+	readonly spans: readonly Span[]
+	readonly focus: Span
+	readonly state: string
+}
+
+/** Carries the corrected discriminator without predecessor whole-candidate labels. */
+export interface ScreenPacket extends Pick<Packet, 'id' | 'identity' | 'digest' | 'question' | 'separator' | 'sources' | 'suffix' | 'sequence' | 'bindings' | 'rendering'> {
+	readonly specification: Binding
+	readonly original: Binding
+	readonly predecessor: Binding
+	readonly labels: Binding
+	readonly operator: string
+	readonly census: readonly Census[]
+	readonly variants: readonly Census[]
+}
+
+/** Carries the score fields required by the fixed ranking screen. */
+export type RankingReading = Pick<Reading, 'ordinal' | 'name' | 'score'>
+
+/** Carries a supported-versus-unsupported comparison within its own pass. */
+export interface Comparison {
+	readonly pass: 'forward' | 'reverse'
+	readonly supported: number
+	readonly unsupported: number
+	readonly exceeds: boolean
+}
+
+/** Carries local discrimination, complete refusal, or incomplete measurement. */
+export interface RankingResult {
+	readonly status: 'passed' | 'refused' | 'incomplete'
+	readonly comparisons: readonly Comparison[]
+}
+
+import type { Binding, Packet, Reading } from '../aggregate-judge-counterfactual/types.ts'
+
