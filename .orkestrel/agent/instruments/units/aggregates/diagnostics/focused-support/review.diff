+		throws(() => validateState(state, [...original.sources].reverse(), variant.candidate, focus), /Ordered/)
+		throws(() => validateState(state, original.sources, `${variant.candidate}!`, focus), /Candidate/)
+		throws(() => validateState(state, original.sources, variant.candidate, { ...focus, end: focus.end - 1 }), /Focus/)
+		throws(() => selectFocus('No repair marker.', partitionCandidate('No repair marker.')), /absent/)
+		const duplicate = `${variant.candidate}\n${focus.text}`
+		throws(() => selectFocus(duplicate, partitionCandidate(duplicate)), /repeated/)
+	}
+	const candidate = `literal "quote" \\ slash\n${FOCUS_MARKER} Ω😀.`
+	const focus = selectFocus(candidate, partitionCandidate(candidate))
+	const sources = [{ id: 'literal', sentence: 0, role: 'user', text: candidate, day: '2026-10-10', seed: 0 }]
+	validateState(renderState(sources, candidate, focus), sources, candidate, focus)
+	throws(() => readSource({ ...sources[0], role: 'invalid' }), /role/)
+})
+
+test('actual native rendering preserves judge identity, settings, system, and question criteria without dispatch', () => {
+	const witness = new NetworkWitness()
+	try {
+		const original = readPacket(readJSON(PREDECESSOR))
+		const tuple = readArray(JSON.parse(original.identity))
+		const judge = createOllamaJudge({ model: readString(tuple[0]), system: readString(tuple[1]), calibration: { temperature: readNumber(tuple[2]) }, options: readObject(tuple[3]) })
+		ok(judge instanceof AgentJudge)
+		equal(judge.model, original.identity)
+		const question = readObject(readJSON(SPECIFICATION)).question
+		ok(isJudgeQuestion(question))
+		deepStrictEqual(question.criteria, readObject(original.question).criteria)
+		for (const variant of original.variants) {
+			const state = renderState(original.sources, variant.candidate, selectFocus(variant.candidate, partitionCandidate(variant.candidate)))
+			const body = readObject(judge.body({ state, questions: { agree: question } }))
+			equal(body.prompt, renderJudgePrompt(state, question, readString(tuple[1])))
+			const prior = original.rendering.find(entry => entry.name === variant.name)
+			ok(prior !== undefined)
+			const previous = readObject(JSON.parse(prior.body))
+			deepStrictEqual(Object.fromEntries(Object.entries(body).filter(([key]) => key !== 'prompt')), Object.fromEntries(Object.entries(previous).filter(([key]) => key !== 'prompt')))
+		}
+		equal(witness.count, 0)
+	} finally { witness.close() }
+})
+
+test('corrected candidates are exact declared single-line replacements with accepted label and runtime custody', () => {
+	const predecessor = readPacket(readJSON(PREDECESSOR))
+	const packet = readScreen(readJSON(PACKET))
+	const spec = readObject(readJSON(SPECIFICATION))
+	deepStrictEqual(packet.sources, predecessor.sources)
+	deepStrictEqual(packet.question, spec.question)
+	deepStrictEqual(packet.sequence, SEQUENCE)
+	equal(packet.identity, predecessor.identity)
+	equal(packet.digest, predecessor.digest)
+	equal(packet.labels.hash, LABELS_HASH)
+	equal(packet.original.hash, ORIGINAL_HASH)
+	equal(packet.specification.hash, SPECIFICATION_HASH)
+	equal(packet.predecessor.hash, PREDECESSOR_HASH)
+	validatePopulation(packet, predecessor)
+	const baseline = predecessor.variants.find(variant => variant.name === 'both-removed')
+	ok(baseline !== undefined)
+	for (const [index, variant] of packet.variants.entries()) {
+		const declared = readObject(readArray(spec.variants)[index])
+		equal(variant.candidate, declared.candidate)
+		equal(variant.focus.text, declared.focus)
+		equal(variant.candidate, deriveCandidate(predecessor, readString(declared.focus)))
+		deepStrictEqual(variant.candidate.split(/\r\n|\n/).filter((_, position) => position !== 1), baseline.candidate.split(/\r\n|\n/).filter((_, position) => position !== 1))
+		deepStrictEqual(selectStatement(variant.candidate, variant.spans, readString(declared.focus)), variant.focus)
+		deepStrictEqual(readCensus(variant), variant)
+		throws(() => selectStatement(variant.candidate, variant.spans, variant.focus.text.slice(1)), /complete partition/)
+		throws(() => selectStatement(variant.candidate, variant.spans, 'Missing statement.'), /absent/)
+		throws(() => deriveCandidate(predecessor, `${variant.focus.text}\nExtra.`), /replacement line/)
+		const mutated = { ...packet, variants: packet.variants.map((entry, position) => position === index ? { ...entry, candidate: `${entry.candidate}!` } : entry) }
+		throws(() => validatePopulation(mutated, predecessor), /single-line/)
+		throws(() => validatePopulation({ ...packet, variants: packet.variants.map((entry, position) => position === index ? { ...entry, focus: { ...entry.focus, start: entry.focus.start + 1 } } : entry) }, predecessor), /focus custody/)
+	}
+	for (const binding of packet.bindings) equal(readBinding(resolve(ROOT, binding.path)).hash, binding.hash)
+	for (const name of EMITTED_FILES) ok(packet.bindings.some(binding => resolve(ROOT, binding.path) === resolve(HARNESS, '.build', name)))
+	for (const name of REUSED_FILES) ok(packet.bindings.some(binding => resolve(ROOT, binding.path) === resolve(UNIT, '../aggregate-judge-counterfactual', name)))
+	const tuple = readArray(JSON.parse(packet.identity))
+	const judge = createOllamaJudge({ model: readString(tuple[0]), system: readString(tuple[1]), calibration: { temperature: readNumber(tuple[2]) }, options: readObject(tuple[3]) })
+	ok(judge instanceof AgentJudge)
+	ok(isJudgeQuestion(packet.question))
+	for (const variant of packet.variants) equal(JSON.stringify(judge.body({ state: variant.state, questions: { agree: packet.question } })), packet.rendering.find(entry => entry.name === variant.name)?.body)
+	deepStrictEqual(packet.rendering.map(entry => entry.name), ['statement-a', 'statement-b'])
+})
+
+test('accepted supported focus must exceed the unsupported focus separately in each pass', () => {
+	const readings = SEQUENCE.map((name, index) => ({ ordinal: index + 1, name, score: name === 'statement-b' ? 0.9 : 0.2 }))
+	const ranking = computeRanking(readings)
+	equal(ranking.status, 'passed')
+	deepStrictEqual(ranking.comparisons.map(comparison => comparison.pass), ['forward', 'reverse'])
+	equal(computeRanking(readings.map(reading => ({ ...reading, score: 0.5 }))).status, 'refused')
+	equal(computeRanking(readings.map(reading => ({ ...reading, score: 1 - reading.score }))).status, 'refused')
+	const reverse = computeRanking(readings.map(reading => ({ ...reading, score: reading.ordinal === 3 ? 0.1 : reading.score })))
+	equal(reverse.status, 'refused')
+	ok(reverse.comparisons[0]?.exceeds === true)
+	ok(reverse.comparisons[1]?.exceeds === false)
+	equal(computeRanking(readings.slice(0, -1)).status, 'incomplete')
+	throws(() => computeRanking(readings.map(reading => ({ ...reading, score: Number.NaN }))), /finite/)
+	throws(() => computeRanking(readings.map(reading => ({ ...reading, score: Number.POSITIVE_INFINITY }))), /finite/)
+	throws(() => computeRanking(readings.map(reading => ({ ...reading, score: -0.1 }))), /probability/)
+	throws(() => computeRanking(readings.map(reading => ({ ...reading, score: 1.1 }))), /probability/)
+	throws(() => computeRanking([...readings, ...readings]), /overrun/)
+	throws(() => computeRanking(readings.map(reading => ({ ...reading, ordinal: reading.ordinal + 1 }))), /sequence/)
+})
+
+test('invalid hashes and occupied outputs refuse before global or native fetch', async () => {
+	const witness = new NetworkWitness()
+	const fetch = globalThis.fetch
+	let count = 0
+	Object.defineProperty(globalThis, 'fetch', { configurable: true, writable: true, value: () => { count += 1; return Promise.reject(new Error('Offline test refuses fetch')) } })
+	try {
+		const options = { packet: readBinding(PACKET).hash, build: BUILD_HASH, operator: computeOperator(), output: resolve(UNIT, `proof-vacant-${process.pid}`) }
+		equal(validateExecution(options).operator, options.operator)
+		for (const field of ['packet', 'build', 'operator']) await rejects(new Operator().execute({ ...options, [field]: '0'.repeat(64) }), /hash|Hash/)
+		const occupied = resolve(UNIT, `proof-execution-occupied-${process.pid}`)
+		mkdirSync(occupied)
+		await rejects(new Operator().execute({ ...options, output: occupied }), /occupied/)
+		await rejects(new Operator().execute({ ...options, output: resolve(UNIT, '..') }), /descendant/)
+		equal(count, 0)
+		equal(witness.count, 0)
+	} finally { globalThis.fetch = fetch; witness.close() }
+})
+
+test('corrected packet preparation repeats byte-for-byte and rejects occupied or escaped output before dispatch', () => {
+	const witness = new NetworkWitness()
+	try {
+		const first = resolve(UNIT, `proof-census-first-${process.pid}`)
+		const second = resolve(UNIT, `proof-census-second-${process.pid}`)
+		new Operator().prepare(first)
+		new Operator().prepare(second)
+		equal(readBinding(resolve(first, 'packet-final.json')).hash, readBinding(resolve(second, 'packet-final.json')).hash)
+		equal(readBinding(resolve(first, 'packet-final.json')).hash, readBinding(PACKET).hash)
+		deepStrictEqual(readObject(readJSON(resolve(first, 'plan-final.json'))).guard, { dispatches: 0, native: 0 })
+		throws(() => new Operator().prepare(first), /occupied/)
+		throws(() => new Operator().prepare(resolve(UNIT, '..')), /descendant/)
+		throws(() => validateDestination(UNIT), /descendant/)
+		const occupied = resolve(UNIT, `proof-occupied-${process.pid}`)
+		mkdirSync(occupied)
+		throws(() => new Operator().prepare(occupied), /occupied/)
+		equal(witness.count, 0)
+	} finally { witness.close() }
+})
