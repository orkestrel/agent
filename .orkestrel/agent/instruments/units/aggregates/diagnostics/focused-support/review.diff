+import { test } from 'node:test'
+import { readJSON, readPacket } from '../aggregate-judge-counterfactual/helpers.ts'
+import { PACKET, PREDECESSOR, SEQUENCE } from './constants.ts'
+import { computeRanking, partitionCandidate, readScreen, renderState, selectFocus, validateCoverage, validatePopulation, validateState } from './helpers.ts'
+
+test('dropped span control must fail complete coverage', () => {
+	const candidate = 'First supported. Final unsupported prerequisite.'
+	validateCoverage(candidate, partitionCandidate(candidate).slice(0, -1))
+})
+
+test('changed offset control must fail exact slice custody', () => {
+	const candidate = 'First. Second.'
+	validateCoverage(candidate, partitionCandidate(candidate).map(span => ({ ...span, start: span.start + 1 })))
+})
+
+test('changed text control must fail exact slice custody', () => {
+	const candidate = 'First. Second.'
+	validateCoverage(candidate, partitionCandidate(candidate).map(span => ({ ...span, text: `${span.text}!` })))
+})
+
+test('swapped chronology control must fail ordered source custody', () => {
+	const original = readPacket(readJSON(PREDECESSOR))
+	const candidate = original.variants[0]?.candidate ?? ''
+	const focus = selectFocus(candidate, partitionCandidate(candidate))
+	validateState(renderState([...original.sources].reverse(), candidate, focus), original.sources, candidate, focus)
+})
+
+test('omitted source control must fail source membership custody', () => {
+	const original = readPacket(readJSON(PREDECESSOR))
+	const candidate = original.variants[0]?.candidate ?? ''
+	const focus = selectFocus(candidate, partitionCandidate(candidate))
+	validateState(renderState(original.sources.slice(1), candidate, focus), original.sources, candidate, focus)
+})
+import { equal } from 'node:assert'
+
+test('corrected candidate drift control must fail single-line custody', () => {
+	const packet = readScreen(readJSON(PACKET))
+	validatePopulation({ ...packet, variants: packet.variants.map(variant => ({ ...variant, candidate: `${variant.candidate}!` })) }, readPacket(readJSON(PREDECESSOR)))
+})
+
+test('corrected focus drift control must fail exact focus custody', () => {
+	const packet = readScreen(readJSON(PACKET))
+	validatePopulation({ ...packet, variants: packet.variants.map(variant => ({ ...variant, focus: { ...variant.focus, text: `${variant.focus.text}!` } })) }, readPacket(readJSON(PREDECESSOR)))
+})
+
+test('missing reading control must fail complete ranking assertion', () => {
+	equal(computeRanking(SEQUENCE.slice(0, -1).map((name, index) => ({ ordinal: index + 1, name, score: name === 'statement-b' ? 0.9 : 0.2 }))).status, 'passed')
