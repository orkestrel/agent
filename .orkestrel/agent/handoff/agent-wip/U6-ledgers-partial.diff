+import { describe, expect, it } from 'vitest'
+import { isFraction, isPositiveSafeInteger } from '../../../../src/core/ledgers/validators.js'
+
+describe('isFraction', () => {
+	it('accepts a number above 0 up to and including 1', () => {
+		for (const value of [1, 0.7, 0.3, Number.MIN_VALUE]) expect(isFraction(value)).toBe(true)
+	})
+
+	it('refuses 0, a negative, a value above 1, and a nonfinite number', () => {
+		for (const value of [0, -0, -0.5, 1 + Number.EPSILON, 2, Number.NaN, Infinity, -Infinity])
+			expect(isFraction(value)).toBe(false)
+	})
+
+	it('refuses a value that is not a number', () => {
+		for (const value of ['0.5', undefined, null, {}, [0.5], 1n]) expect(isFraction(value)).toBe(false)
+	})
+})
+
+describe('isPositiveSafeInteger', () => {
+	it('accepts a safe integer above 0', () => {
+		for (const value of [1, 4096, Number.MAX_SAFE_INTEGER]) expect(isPositiveSafeInteger(value)).toBe(true)
+	})
+
+	it('refuses 0, a negative, a fraction, an unsafe integer, and a nonfinite number', () => {
+		for (const value of [0, -0, -5, 1.5, Number.MAX_SAFE_INTEGER + 1, Number.NaN, Infinity])
+			expect(isPositiveSafeInteger(value)).toBe(false)
+	})
+
+	it('refuses a value that is not a number', () => {
+		for (const value of ['1', undefined, null, {}, [1], 1n])
+			expect(isPositiveSafeInteger(value)).toBe(false)
+	})
+})
