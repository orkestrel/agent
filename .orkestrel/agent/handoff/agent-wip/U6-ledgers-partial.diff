+import { isFiniteNumber, isNumber } from '@orkestrel/contract'
+
+/**
+ * Checks whether a value is a finite number greater than 0 and at most 1.
+ *
+ * @param value - The value to check
+ * @returns True if `value` is a number in the interval above 0 up to and including 1; false otherwise
+ *
+ * @example
+ * ```ts
+ * isFraction(0.7) // true
+ * isFraction(0) // false
+ * ```
+ */
+export function isFraction(value: unknown): value is number {
+	return isFiniteNumber(value) && value > 0 && value <= 1
+}
+
+/**
+ * Checks whether a value is a safe integer greater than 0.
+ *
+ * @param value - The value to check
+ * @returns True if `value` is a positive safe integer; false otherwise
+ *
+ * @example
+ * ```ts
+ * isPositiveSafeInteger(32_768) // true
+ * isPositiveSafeInteger(0) // false
+ * ```
+ */
+export function isPositiveSafeInteger(value: unknown): value is number {
+	return isNumber(value) && Number.isSafeInteger(value) && value > 0
+}
